[Unit]
Description=WhatsCRM Node.js application
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=whatscrm
Group=www-data
WorkingDirectory=/opt/whatscrm/server
EnvironmentFile=/etc/whatscrm/whatscrm.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/whatscrm/server

[Install]
WantedBy=multi-user.target
